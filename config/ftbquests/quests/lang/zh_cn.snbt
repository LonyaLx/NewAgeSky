	quest.2DE80409B008F780.title: "阶段 1 · 天工合金框架"
	quest.2DE80409B008F780.quest_desc: ["Extreme Package Crafter 有序配方，一次产出 4 个。", "它是 ProjectE 核心、创造链和终局设备的通用结构材料。"]
	quest.68FA6734FBB66555.title: "阶段 1 · 量子控制矩阵"
	quest.68FA6734FBB66555.quest_desc: ["一次产出 4 个，统一替代后期反复消耗的量子核心、控制电路和 ME 封包组件。"]
	quest.0E53691DB1E3F726.title: "阶段 1 · EMC 聚焦模块"
	quest.0E53691DB1E3F726.quest_desc: ["一次产出 4 个，用于压缩 ProjectE 和无尽终局中的燃料及控制材料数量。"]
	quest.31717FA9076EAAD2.title: "阶段 2 · 无尽结构核心"
	quest.31717FA9076EAAD2.quest_desc: ["使用无限催化剂、水晶矩阵锭、中子锭、EMC 聚焦模块和量子控制矩阵制作，一次产出 2 个。"]
	quest.28176265310074B8.title: "阶段 2 · 天工框架"
	quest.28176265310074B8.quest_desc: ["一次产出 4 个，作为世界心矩阵的基础结构。"]
	quest.4E8F86590F44A68F.title: "阶段 2 · 世界心矩阵"
	quest.4E8F86590F44A68F.quest_desc: ["使用天工框架、ProjectE 红物质块、觉醒核心、预测矩阵和超新星控制电路制作，一次产出 2 个。"]
	quest.43E670AB0AF7BF0F.title: "阶段 3 · 天工之心"
	quest.43E670AB0AF7BF0F.quest_desc: ["一次产出 4 个。它不是单件消耗品，而是整条创造链的批量入场券。"]
	quest.121D7AEEEBCAA103.title: "创造链 01 · 创造能源立方"
	quest.121D7AEEEBCAA103.quest_desc: ["创造链根节点。先制作创造能源立方，后续动力和存储分支均从这里展开。"]
	quest.14813E58EA83D1C7.title: "创造链 02 · Create 创造马达"
	quest.14813E58EA83D1C7.quest_desc: ["需要创造能源立方、天工合金框架和 Create 精密机构。"]
	quest.7A6EA54611489DB3.title: "创造链 03 · Mekanism 创造储物箱"
	quest.7A6EA54611489DB3.quest_desc: ["能源核心的固体存储支线，用于后续气动创造压缩铁块。"]
	quest.26746DEEA13642A8.title: "创造链 04 · Create 创造板条箱"
	quest.26746DEEA13642A8.quest_desc: ["由创造马达推进，并接入气动创造线。"]
	quest.3D92C9008156DAEB.title: "创造链 05 · Mekanism 创造流体储罐"
	quest.3D92C9008156DAEB.quest_desc: ["能源核心的流体存储支线，是化学储罐和 Create 创造流体罐的前置。"]
	quest.6D1CD3117A7CD776.title: "创造链 06 · Mekanism 创造化学储罐"
	quest.6D1CD3117A7CD776.quest_desc: ["将创造流体储罐升级为化学储罐，并用于龙研创造电容。"]
	quest.048DA5136F238C4C.title: "创造链 07 · Create 创造流体罐"
	quest.048DA5136F238C4C.quest_desc: ["在 Mekanism 创造流体储罐之后，接入 Create 流体储存体系。"]
	quest.5943B3FAEB3557F3.title: "创造链 08 · 龙研创造电容"
	quest.5943B3FAEB3557F3.quest_desc: ["同时需要创造能源立方和 Mekanism 创造化学储罐。"]
	quest.5CD7AAD980DA0071.title: "创造链 09 · 气动创造压缩铁块"
	quest.5CD7AAD980DA0071.quest_desc: ["同时需要 Create 创造板条箱和 Mekanism 创造流体储罐。"]
	quest.40E6E052122EB2F5.title: "创造链 10 · JDTe 创造升级"
	quest.40E6E052122EB2F5.quest_desc: ["完成龙研和气动创造支线后，才能制作 JDTe 创造升级。"]
	quest.07D946305346F334.title: "终局汇聚 · 创造收敛核心"
	quest.07D946305346F334.quest_desc: ["将十件创造物品、无尽结构核心、量子控制矩阵和天工合金框架汇聚为一个核心。"]
	quest.1CF1A73A48176C63.title: "最终目标 · ME 创造存储元件"
	quest.1CF1A73A48176C63.quest_desc: ["使用创造收敛核心、无尽结构核心和 ME 终局材料制造 AE2 创造存储元件。", "完成后即达成《天工创世》的最终目标。"]
}